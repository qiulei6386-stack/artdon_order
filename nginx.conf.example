# Example server block for shop.artdonlighting.com
# Adjust PHP-FPM socket and certificate paths for your server.
server {
    listen 80;
    server_name shop.artdonlighting.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name shop.artdonlighting.com;

    root /www/wwwroot/artdon_order;
    index index.php;

    ssl_certificate     /www/server/panel/vhost/cert/shop.artdonlighting.com/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/shop.artdonlighting.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers on;
    ssl_session_tickets off;

    client_max_body_size 20m;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ /\.(?!well-known(?:/|$)) {
        deny all;
        return 404;
    }

    location ~ ^/(config|includes|templates|storage|database|docs|preview|tools|tests)(?:/|$) {
        deny all;
        return 404;
    }

    location ~* ^/(?:README\.md|LICENSE\.txt|nginx\.conf\.example|router\.php)$ {
        deny all;
        return 404;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/tmp/php-cgi-82.sock;
        fastcgi_read_timeout 60s;
    }

    location ~* \.(?:css|js|svg|png|jpg|jpeg|webp|ico)$ {
        expires 30d;
        try_files $uri =404;
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
}
